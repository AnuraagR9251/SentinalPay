# Copy this file to .env and fill in local overrides.
# Never commit a real .env — it is gitignored.

# Comma-separated extra VPN/proxy CIDRs (optional). Placeholder only.
SENTINALPAY_VPN_CIDRS=

# Logging verbosity. Valid values: DEBUG, INFO, WARNING, ERROR
SENTINALPAY_LOG_LEVEL=INFO

# FastAPI /score (local demo). No secrets — origins and model path only.
SENTINALPAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINALPAY_XGB_MODEL=ml/models/xgboost_model.pkl
SENTINALPAY_SCORE_API=http://localhost:8000
