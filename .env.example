# Copy this file to .env and fill in local overrides.
# Never commit a real .env — it is gitignored.

# Comma-separated extra VPN/proxy CIDRs (optional). Placeholder only.
SENTINALPAY_VPN_CIDRS=

# Logging verbosity. Valid values: DEBUG, INFO, WARNING, ERROR
SENTINALPAY_LOG_LEVEL=INFO

# FastAPI /score (local demo). No secrets — origins and model path only.
SENTINALPAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINALPAY_XGB_MODEL=ml/models/xgboost_model.pkl
SENTINALPAY_AE_MODEL=ml/models/autoencoder_model.keras
SENTINALPAY_AE_THRESHOLD=ml/models/autoencoder_threshold.json
SENTINALPAY_SCORE_API=http://127.0.0.1:8000
SENTINALPAY_FEED_MAX=100
SENTINALPAY_GRAPH_WINDOW_SECONDS=86400
SENTINALPAY_STRUCTURING_AMOUNT=50000
SENTINALPAY_MULE_CLUSTER_MIN=5

# Risk pipeline (POST /api/v1/transactions/evaluate). Leave API key empty for local demo.
SENTINALPAY_API_KEY=
SENTINALPAY_DATABASE_URL=sqlite:///data/sentinalpay.db
SENTINALPAY_REDIS_URL=
SENTINALPAY_WEIGHT_RULES=0.25
SENTINALPAY_WEIGHT_BEHAVIOR=0.25
SENTINALPAY_WEIGHT_ML=0.40
SENTINALPAY_WEIGHT_SECURITY=0.10
# Demo policy on blended risk_score 0–100 (not ML probability). Starting values, not calibrated.
SENTINALPAY_DECIDE_ALLOW_MAX=29
SENTINALPAY_DECIDE_REVIEW_MAX=69
SENTINALPAY_HIGH_RISK_CATEGORIES=gambling,crypto,jewelry
SENTINALPAY_REQUIRE_LOGIN=0
SENTINALPAY_SESSION_TTL_SECONDS=43200
SENTINALPAY_PBKDF2_ROUNDS=120000
# Demo login (local only): aarav@senitenial / demo123 / PIN 1234

# Razorpay TEST mode only. Leave empty to skip live API calls.
# Webhook HMAC still unit-tested without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SENTINALPAY_WEBHOOK_MAX_AGE_SECONDS=259200
